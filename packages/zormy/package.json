{
	"name": "zormy",
	"version": "1.0.4",
	"private": false,
	"description": "Formulários reutilizáveis para a plataforma Incentiv",
	"repository": {
		"type": "git",
		"url": "https://github.com/renanzan/zormy"
	},
	"type": "module",
	"zshy": {
		"exports": "./src/index.ts"
	},
	"exports": {
		".": {
			"types": "./dist/src/index.d.cts",
			"import": "./dist/src/index.js",
			"require": "./dist/src/index.cjs"
		}
	},
	"scripts": {
		"build": "zshy --project tsconfig.build.json",
		"dev": "tsc --project tsconfig.build.json --watch",
		"test": "vitest",
		"test:coverage": "vitest --coverage",
		"test:watch": "vitest --watch",
		"test:typecheck": "vitest --typecheck.only --run",
		"test:bench": "vitest bench --run"
	},
	"peerDependencies": {
		"@hookform/resolvers": "^5.2.2",
		"react": "^18.0.0 || ^19.0.0",
		"react-hook-form": "^7.71.1",
		"zod": "^3.25.28"
	},
	"devDependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.1",
		"@types/react": "catalog:",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"esbuild": "^0.28.0",
		"jsdom": "catalog:",
		"react-hook-form": "^7.76.1",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zshy": "^0.7.2"
	},
	"files": [
		"dist",
		"AI_SPEC.md"
	],
	"aiSpec": "AI_SPEC.md",
	"main": "./dist/src/index.cjs",
	"module": "./dist/src/index.js",
	"types": "./dist/src/index.d.cts",
	"publishConfig": {
		"access": "public"
	}
}
