{
	"name": "root",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"check-deps": "deps-guard",
		"build": "pnpm run check-deps && pnpm --filter \"zormy\" build",
		"dev": "pnpm run check-deps && pnpm --filter \"@zormy/example\" dev",
		"dev:docs": "pnpm run check-deps && pnpm --filter \"@zormy/docs\" dev",
		"dev:test-build": "pnpm run check-deps && pnpm --filter \"@zormy/test-build\" dev",
		"test": "pnpm --filter \"zormy\" test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@next/eslint-plugin-next": "^16.1.6",
		"@tailwindcss/postcss": "^4.1.18",
		"deps-guard": "^0.0.1",
		"enquirer": "^2.4.1",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"nextra": "^4.6.1",
		"nextra-theme-docs": "^4.6.1",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.56.0"
	},
	"packageManager": "pnpm@10.18.1+sha512.77a884a165cbba2d8d1c19e3b4880eee6d2fcabd0d879121e282196b80042351d5eb3ca0935fa599da1dc51265cc68816ad2bddd2a2de5ea9fdf92adbec7cd34"
}
