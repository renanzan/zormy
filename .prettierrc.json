{
	"useTabs": true,
	"tabWidth": 2,
	"semi": true,
	"singleQuote": false,
	"trailingComma": "es5",
	"printWidth": 100,
	"arrowParens": "always",
	"endOfLine": "lf",
	"plugins": ["@ianvs/prettier-plugin-sort-imports"],
	"importOrder": [
		"^react$",
		"^react/(.*)$",
		"^zod$",
		"^react-hook-form$",
		"<THIRD_PARTY_MODULES>",
		"",
		"^[./]",
		"",
		"<TYPES>^react$",
		"<TYPES>^react/(.*)$",
		"<TYPES>^zod$",
		"<TYPES>^react-hook-form$",
		"<TYPES>",
		"<TYPES>^[./]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"],
	"importOrderTypeScriptVersion": "5.0.0"
}
